allow hal_camera_default vendor_sysfs_camera:dir r_dir_perms;
allow hal_camera_default vendor_sysfs_camera:file r_file_perms;

# Laser/ToF sensor
allow hal_camera_default input_device:dir r_dir_perms;
allow hal_camera_default input_device:chr_file r_file_perms;
r_dir_file(hal_camera_default, vendor_sysfs_input)
allow hal_camera_default vendor_sysfs_input:file rw_file_perms;
r_dir_file(hal_camera_default, vendor_sysfs_laser)

# Battery info
r_dir_file(hal_camera_default, sysfs_batteryinfo)

# Lineage DisplayService (SurfaceFlinger)
allow hal_camera_default fwk_display_hwservice:hwservice_manager find;
binder_call(hal_camera_default, display_service_server)
binder_call(display_service_server, hal_camera_default)
